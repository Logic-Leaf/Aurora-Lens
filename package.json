    "keybindings": [
      {
        "command": "auroralens.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorLangId == sql"
      }
    ],
    "configuration": {
      "title": "AuroraLens",
      "properties": {
        "auroralens.connections": {
          "type": "array",
          "default": [],
          "scope": "application",
          "markdownDescription": "Database connections. Non-secret details only: credentials come from your AWS profile and the database password stays in Secrets Manager.\n\nExample:\n```json\n{\n  \"name\": \"orders-dev\",\n  \"environment\": \"dev\",\n  \"profile\": \"my-dev-profile\",\n  \"region\": \"us-east-1\",\n  \"clusterArn\": \"arn:aws:rds:us-east-1:111122223333:cluster:orders-dev\",\n  \"secretArn\": \"arn:aws:secretsmanager:us-east-1:111122223333:secret:orders-dev-reader-AbCdEf\",\n  \"database\": \"orders\"\n}\n```",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "environment",
              "profile",
              "region",
              "clusterArn",
              "secretArn",
              "database"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 64,
                "description": "Display name."
              },
              "environment": {
                "type": "string",
                "enum": [
                  "dev",
                  "qa",
                  "staging",
                  "prod"
                ],
                "enumDescriptions": [
                  "Development",
                  "QA / test (confirmation before writes)",
                  "Staging (confirmation before writes)",
                  "Production (always read-only)"
                ]
              },
              "profile": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+=-]{0,63}$",
                "description": "AWS profile name from ~/.aws/config."
              },
              "region": {
                "type": "string",
                "pattern": "^[a-z]{2}(-[a-z]+)+-\\d{1,2}$"
              },
              "clusterArn": {
                "type": "string",
                "pattern": "^arn:aws(-cn|-us-gov|-iso|-iso-b)?:rds:[a-z0-9-]+:\\d{12}:cluster:[A-Za-z][A-Za-z0-9-]{0,62}$"
              },
              "secretArn": {
                "type": "string",
                "pattern": "^arn:aws(-cn|-us-gov|-iso|-iso-b)?:secretsmanager:[a-z0-9-]+:\\d{12}:secret:.+$",
                "description": "Prefer a secret for a read-only database role."
              },
              "database": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_$]{0,62}$"
              }
            }
          }
        },
        "auroralens.ssoSession": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "scope": "application",
          "markdownDescription": "AWS IAM Identity Center session used by **Sign in**. Set it with the command **AuroraLens: Set up AWS IAM Identity Center**. Leave empty if your profiles already exist in `~/.aws/config`.",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+=-]{0,63}$",
              "default": "auroralens"
            },
            "startUrl": {
              "type": "string",
              "pattern": "^https://",
              "description": "AWS access portal URL, e.g. https://my-company.awsapps.com/start"
            },
            "region": {
              "type": "string",
              "pattern": "^[a-z]{2}(-[a-z]+)+-\\d{1,2}$"
            },
            "roleName": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_+=,.@-]{1,64}$",
              "description": "Permission set name used for auto-created profiles."
            }
          }
        },
        "auroralens.readOnly": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Run statements in a server-enforced read-only transaction that is always rolled back. `prod` connections are read-only regardless of this setting."
        },
        "auroralens.maxRows": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "maximum": 10000,
          "scope": "application",
          "description": "LIMIT appended to top-level SELECT statements that have none."
        },
        "auroralens.statementTimeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 300,
          "scope": "application",
          "description": "Server-side statement_timeout for read-only statements."
        },
        "auroralens.history.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Keep a local history of executed SQL text (never result data)."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "auroralens.explorer",
        "when": "!auroralens.hasConnection",
        "contents": "Query private Amazon Aurora databases with your AWS SSO identity. No VPN, bastion host or stored passwords.\n[$(add) Add Connection](command:auroralens.addConnection)\n[$(key) Sign in with AWS SSO](command:auroralens.login)\nRead-only by default. Connections are stored in your user settings, never in the workspace."
      },
      {
        "view": "auroralens.history",
        "contents": "Statements you run appear here. Click one to reopen it; use ▶ to run it again.\nOnly the SQL text is kept, never results."
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "tsc -p ./tsconfig.test.json && node --test \"out/test/**/*.test.js\"",
    "package": "npm run compile && npm test && vsce package",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1175.0",
    "@aws-sdk/client-rds": "^3.1175.0",
    "@aws-sdk/client-rds-data": "^3.600.0",
    "@aws-sdk/credential-providers": "^3.600.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Logic-Leaf/auroralens.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "All AuroraLens settings are user-level (application scope), so a workspace cannot change connections, sign-in or read-only mode."
    },
    "virtualWorkspaces": false
  },
  "homepage": "https://github.com/Logic-Leaf/auroralens#readme",
  "bugs": {
    "url": "https://github.com/Logic-Leaf/auroralens/issues"
  }
}
