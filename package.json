{
  "name": "auroralens",
  "displayName": "AuroraLens",
  "description": "The secure way to query Amazon Aurora from VS Code. No VPN. No bastion. No stored passwords.",
  "version": "0.4.0",
  "preview": true,
  "publisher": "anujshrigiriwar",
  "author": {
    "name": "Anuj Shrigiriwar",
    "url": "https://github.com/Logic-Leaf"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B1430",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "aws",
    "amazon aurora",
    "aurora",
    "postgresql",
    "postgres",
    "rds",
    "rds data api",
    "sql",
    "sql client",
    "database",
